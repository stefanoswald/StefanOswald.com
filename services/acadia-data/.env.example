# Copy this file to ".env" in the same folder and fill it in.
# Never put the real .env file in the public code repository.

# The shared secret between the website and this database. Make a long random one, for example
# with:  openssl rand -base64 48
# Put the same value in Vercel as ACADIA_DATA_KEY.
ACADIA_DATA_KEY=

# How many daily backup copies to keep in data/backups.
BACKUP_KEEP_DAYS=30

# Time zone for backup file dates.
TZ=America/New_York

# Option A, Tailscale Funnel. An auth key from the Tailscale admin console, and the name this
# machine should have on the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=acadia-data

# Option B, Cloudflare Tunnel. The tunnel token from the Cloudflare dashboard.
CF_TUNNEL_TOKEN=
